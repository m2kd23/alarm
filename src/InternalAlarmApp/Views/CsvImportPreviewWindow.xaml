<Window x:Class="InternalAlarmApp.Views.CsvImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CSV 가져오기 미리보기" Width="850" Height="580" MinWidth="620" MinHeight="380"
        Icon="../app_icon.png" WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="CSV 가져오기 미리보기" FontSize="23" FontWeight="Bold" Foreground="#1558A6"/>
        <TextBlock Grid.Row="1" x:Name="SummaryText" Margin="0,8,0,15" TextWrapping="Wrap"/>
        <DataGrid Grid.Row="2" x:Name="RowsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="행" Binding="{Binding RowNumber}" Width="60"/>
                <DataGridTextColumn Header="결과" Binding="{Binding Result}" Width="70"/>
                <DataGridTextColumn Header="제목" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="일시" Binding="{Binding DateTimeText}" Width="145"/>
                <DataGridTextColumn Header="상세" Binding="{Binding Message}" Width="280"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="ImportButton" Content="정상 항목 가져오기" Click="Import_Click" Background="#1558A6" Foreground="White"/>
            <Button Content="취소" IsCancel="True" Width="90"/>
        </StackPanel>
    </Grid>
</Window>
