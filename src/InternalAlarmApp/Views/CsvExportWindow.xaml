<Window x:Class="InternalAlarmApp.Views.CsvExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CSV 내보내기" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        Icon="../app_icon.png" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="선택한 기간 업무 내보내기" FontSize="22" FontWeight="Bold" Foreground="#1558A6" Margin="0,0,0,18"/>
        <TextBlock Grid.Row="1" Text="시작 날짜" VerticalAlignment="Center"/><DatePicker Grid.Row="1" Grid.Column="1" x:Name="FromDateBox" Height="34" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
        <TextBlock Grid.Row="2" Text="종료 날짜" VerticalAlignment="Center" Margin="0,12,0,0"/><DatePicker Grid.Row="2" Grid.Column="1" x:Name="ToDateBox" Height="34" Margin="0,12,0,0" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="취소" Width="90" IsCancel="True"/><Button Content="저장 위치 선택" Click="Export_Click" Background="#1558A6" Foreground="White"/></StackPanel>
    </Grid>
</Window>
