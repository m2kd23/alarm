<Window x:Class="InternalAlarmApp.Views.CsvExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CSV 내보내기" Width="460" Height="260" ResizeMode="NoResize"
        Icon="../app_icon.png" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="주간 업무 CSV 내보내기" FontSize="22" FontWeight="Bold" Foreground="#1558A6" Margin="0,0,0,18"/>
        <TextBlock Grid.Row="1" Text="시작 날짜" VerticalAlignment="Center"/><DatePicker Grid.Row="1" Grid.Column="1" x:Name="FromDateBox"/>
        <TextBlock Grid.Row="2" Text="종료 날짜" VerticalAlignment="Center" Margin="0,12,0,0"/><DatePicker Grid.Row="2" Grid.Column="1" x:Name="ToDateBox" Margin="0,12,0,0"/>
        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Foreground="#666" TextWrapping="Wrap" Margin="0,14,0,0" Text="UTF-8 CSV로 저장합니다. 제목·설명·원문·연결 대상에 포함된 업무 정보는 저장 위치의 접근 권한을 확인해 주세요."/>
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="취소" Width="90" IsCancel="True"/><Button Content="저장 위치 선택" Click="Export_Click" Background="#1558A6" Foreground="White"/></StackPanel>
    </Grid>
</Window>
