<Window x:Class="InternalAlarmApp.Views.MorningBriefingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="모닝 브리핑" Width="620" Height="650" MinWidth="500" MinHeight="420"
        Icon="../app_icon.png" WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="오늘의 모닝 브리핑" FontSize="25" FontWeight="Bold" Foreground="#1558A6"/>
        <TextBlock Grid.Row="1" x:Name="SummaryText" Foreground="#666" Margin="0,6,0,16"/>
        <Grid Grid.Row="2">
            <TextBlock x:Name="EmptyText" Text="오늘 등록된 일정이 없습니다." Foreground="#666" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <ScrollViewer x:Name="CardsScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AlarmCards">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#D6E0EE" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,0,10" Background="#FAFCFF">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="1" Text="{Binding DisplayDateTime}" Foreground="#1558A6" Margin="0,5,0,0"/>
                                    <TextBlock Grid.Row="2" Text="{Binding Description}" Foreground="#555" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                    <DockPanel Grid.Row="3" Margin="0,10,0,0">
                                        <TextBlock Text="{Binding AttachmentSummary}" Foreground="#666" VerticalAlignment="Center"/>
                                        <Button Content="관련 자료 열기" Click="OpenAll_Click" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="목록 열기" Click="ShowList_Click"/><Button Content="닫기" IsCancel="True" Width="85"/>
        </StackPanel>
    </Grid>
</Window>
