<Window x:Class="InternalAlarmApp.Views.DailyWrapUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="데일리 랩업" Width="650" Height="690" MinWidth="520" MinHeight="460"
        Icon="../app_icon.png" WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="오늘의 데일리 랩업" FontSize="25" FontWeight="Bold" Foreground="#1558A6"/>
        <WrapPanel Grid.Row="1" Margin="0,8,0,10">
            <Border Background="#EEF5FF" CornerRadius="6" Padding="11,7" Margin="0,0,8,0"><TextBlock x:Name="CompletedTodayText"/></Border>
            <Border Background="#EEF5FF" CornerRadius="6" Padding="11,7" Margin="0,0,8,0"><TextBlock x:Name="CompletionRateText"/></Border>
            <Border Background="#FFF5E8" CornerRadius="6" Padding="11,7"><TextBlock x:Name="IncompleteText"/></Border>
        </WrapPanel>
        <DockPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="미완료 업무" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <TextBlock Text="연기 날짜" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker x:Name="PostponeDateBox" Width="125"/>
                <Button Content="선택일로 전체 연기" Click="PostponeAllSelectedDate_Click" Margin="7,0,0,0"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="3">
            <TextBlock x:Name="EmptyText" Text="오늘 미완료 업무가 없습니다. 수고하셨습니다." Foreground="#666" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <ScrollViewer x:Name="CardsScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="IncompleteCards">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#F0D4AA" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,0,10" Background="#FFFCF7">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="1" Text="{Binding DisplayDateTime}" Foreground="#8A5A00" Margin="0,5,0,0"/>
                                    <DockPanel Grid.Row="2" Margin="0,10,0,0">
                                        <TextBlock Text="{Binding AttachmentSummary}" Foreground="#666" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                            <Button Content="연결 열기" Click="OpenAll_Click"/>
                                            <Button Content="내일로 연기" Click="PostponeTomorrow_Click" Background="#C56A00" Foreground="White"/>
                                            <Button Content="선택일 연기" Click="PostponeSelectedDate_Click"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="미완료 전체 내일로 연기" Click="PostponeAllTomorrow_Click"/>
            <Button Content="목록 열기" Click="ShowList_Click"/><Button Content="닫기" IsCancel="True" Width="85"/>
        </StackPanel>
    </Grid>
</Window>
